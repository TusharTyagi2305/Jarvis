# JARVIS Configuration
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
MAX_AGENT_ITERATIONS=10
DEFAULT_AUTO_CONFIRM_SAFE=true
SAFE_WORKING_DIRECTORY=c:\Users\Tusha\Jarvis

# Network & API Settings
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
BROWSER_HEADLESS=false

# Voice & Language Settings
VOICE_ENABLED=true
WAKE_WORD_ENABLED=true
WAKE_WORD=jarvis
STT_PROVIDER=native
TTS_PROVIDER=native
VOICE_LANGUAGE=hi-IN
JARVIS_LANGUAGE=hi-IN
JARVIS_SECONDARY_LANGUAGE=en-IN
JARVIS_AUTO_LANGUAGE_DETECTION=true
JARVIS_DEBUG_MODE=false
VOICE_TIMEOUT_SECONDS=8
CONVERSATION_TIMEOUT_SECONDS=8
VOICE_INPUT_DEVICE=default
VOICE_ENERGY_THRESHOLD=300
VOICE_DYNAMIC_ENERGY=true
VOICE_AMBIENT_CALIBRATION_SECONDS=1.5
VOICE_DEBUG=true
VOICE_CONVERSATION_MODE=true
VOICE_CONVERSATION_TIMEOUT_SECONDS=25
JARVIS_DEBUG_PIPELINE=true

# Vision Settings
VISION_ENABLED=true
VISION_PROVIDER=gemini
VISION_MODEL=gemini-2.5-flash
VISION_CLICK_CONFIDENCE_THRESHOLD=0.85
VISION_MAX_IMAGE_SIZE=1280

# Memory Settings
MEMORY_ENABLED=true
SEMANTIC_MEMORY_ENABLED=true
ALLOW_AUTOMATIC_MEMORY=false
MEMORY_MAX_RESULTS=5
MEMORY_DB_PATH=data/memory/jarvis_memory.db

# Task Planning Settings
MAX_TASK_STEPS=30
MAX_STEP_RETRIES=2
MAX_AGENT_ITERATIONS=50
MAX_TASK_DURATION_SECONDS=1800

# Production & Startup Settings
JARVIS_VERSION=1.0.0
JARVIS_START_WITH_WINDOWS=false
JARVIS_START_MINIMIZED=false
JARVIS_BACKGROUND_MODE=true
JARVIS_AUTO_OPEN_DASHBOARD=true
JARVIS_FLOATING_MODE=true
JARVIS_ALWAYS_ON_TOP=false
GLOBAL_HOTKEY=ctrl+space
JARVIS_DESKTOP_WRAPPER=pywebview
